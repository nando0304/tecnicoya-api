<?xml version="1.0" encoding="UTF-8"?>

<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0">

    <Match>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <Match>
        <Package name="com.tecnicoya.api.model"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.tecnicoya.api.security.JwtInterceptor"/>
        <Bug pattern="SERVLET_HEADER"/>
    </Match>

    <Match>
        <Class name="com.tecnicoya.api.service.impl.ArchivoServiceImpl"/>
        <Bug pattern="WEAK_FILENAMEUTILS"/>
    </Match>

    <Match>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
        <Or>
            <And>
                <Class name="com.tecnicoya.api.controller.AuthController"/>
                <Method name="login"/>
            </And>
            <And>
                <Class name="com.tecnicoya.api.controller.ReporteController"/>
                <Method name="descargar"/>
            </And>
            <And>
                <Class name="com.tecnicoya.api.security.JwtInterceptor"/>
                <Method name="verificarRol"/>
            </And>
            <And>
                <Class name="com.tecnicoya.api.service.impl.ReporteServiceImpl"/>
                <Method name="generar"/>
            </And>
            <And>
                <Class name="com.tecnicoya.api.service.impl.UsuarioServiceImpl"/>
                <Method name="~crear|actualizar|eliminar"/>
            </And>
        </Or>
    </Match>

    <Match>
        <Class name="com.tecnicoya.api.exception.GlobalExceptionHandler"/>
        <Method name="manejarGeneral"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <Match>
        <Or>
            <Class name="com.tecnicoya.api.security.MonitoreoSeguridadFilter"/>
            <Class name="com.tecnicoya.api.monitoreo.IdPeticionFilter"/>
        </Or>
        <Bug pattern="SERVLET_HEADER"/>
    </Match>
</FindBugsFilter>
