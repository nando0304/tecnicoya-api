<?xml version="1.0" encoding="UTF-8"?>

<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="LOG_DIR" source="tecnicoya.logs.directorio" defaultValue="logs"/>

    <property name="MENSAJE_SEGURO" value="%replace(%msg){'[\r\n]+', ' '}"/>
    <property name="PATRON_ARCHIVO"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{usuario:-anonimo}] %logger{40} - ${MENSAJE_SEGURO}%n%wEx"/>
    <property name="PATRON_CONSOLA"
              value="%clr(%d{HH:mm:ss.SSS}){faint} %clr(%5level) %clr([%X{usuario:-anonimo}]){magenta} %clr(%logger{36}){cyan} %clr(:){faint} ${MENSAJE_SEGURO}%n%wEx"/>

    <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATRON_CONSOLA}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ARCHIVO" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/tecnicoya-api.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/historial/tecnicoya-api.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${PATRON_ARCHIVO}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ASYNC_ARCHIVO" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="ARCHIVO"/>
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
    </appender>

    <appender name="AUDITORIA" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/auditoria.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/historial/auditoria.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>90</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{usuario:-anonimo}] ${MENSAJE_SEGURO}%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/tecnicoya-api.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/historial/tecnicoya-api.%d{yyyy-MM-dd}.%i.json.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>ecs</format>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <appender name="ASYNC_JSON" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="JSON"/>
        <queueSize>1024</queueSize>
        <discardingThreshold>0</discardingThreshold>
    </appender>

    <logger name="AUDITORIA" level="INFO" additivity="false">
        <appender-ref ref="AUDITORIA"/>
        <appender-ref ref="CONSOLA"/>
        <appender-ref ref="ASYNC_JSON"/>
    </logger>

    <logger name="com.tecnicoya.api" level="INFO"/>
    <logger name="org.apache.poi" level="WARN"/>

    <logger name="org.hibernate.SQL_SLOW" level="INFO"/>

    <logger name="org.hibernate.engine.internal.StatisticalLoggingSessionEventListener" level="WARN"/>

    <springProfile name="dev">
        <logger name="com.tecnicoya.api" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="CONSOLA"/>
        <appender-ref ref="ASYNC_ARCHIVO"/>
        <appender-ref ref="ASYNC_JSON"/>
    </root>

    <springProfile name="nube">
        <springProperty scope="context" name="LOKI_URL" source="LOKI_URL"/>
        <springProperty scope="context" name="LOKI_USUARIO" source="LOKI_USUARIO"/>
        <springProperty scope="context" name="LOKI_TOKEN" source="LOKI_TOKEN"/>

        <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
            <batchTimeoutMs>5000</batchTimeoutMs>
            <http>
                <url>${LOKI_URL}</url>
                <auth>
                    <username>${LOKI_USUARIO}</username>
                    <password>${LOKI_TOKEN}</password>
                </auth>
            </http>
            <format>
                <label>
                    <pattern>app=tecnicoya-api,nivel=%level,logger=%logger{0}</pattern>
                </label>
                <message>
                    <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{usuario:-anonimo}] %logger{40} - ${MENSAJE_SEGURO}%n%wEx</pattern>
                </message>
            </format>
        </appender>

        <logger name="AUDITORIA">
            <appender-ref ref="LOKI"/>
        </logger>

        <root>
            <appender-ref ref="LOKI"/>
        </root>
    </springProfile>
</configuration>
