<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.tecnicoya</groupId>
    <artifactId>tecnicoya-api</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>tecnicoya-api</name>
    <description>API REST de TécnicoYa: plataforma que conecta clientes con técnicos de servicios a domicilio</description>

    <properties>
        <java.version>17</java.version>
        <!-- Spring Boot no gestiona la versión de Commons IO (sí las de Commons Lang y Commons Codec) -->
        <commons-io.version>2.22.0</commons-io.version>
        <jjwt.version>0.13.0</jjwt.version>
        <guava.version>33.4.8-jre</guava.version>
        <poi.version>5.4.1</poi.version>
        <commons-collections4.version>4.5.0</commons-collections4.version>
        <dependency-check.version>12.1.3</dependency-check.version>
    </properties>

    <dependencies>
        <!-- En Spring Boot 4 este starter reemplaza a spring-boot-starter-web (deprecado) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Solo el módulo de cifrado (BCrypt); no activa Spring Security ni protege endpoints -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- JJWT: genera y valida el token JWT que se entrega al iniciar sesión -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Apache Commons -->
        <!-- Lang: normalización de los textos que llegan en las solicitudes (StringUtils) -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>
        <!-- Codec: huella SHA-256 de los archivos subidos, que se usa como su nombre -->
        <dependency>
            <groupId>commons-codec</groupId>
            <artifactId>commons-codec</artifactId>
        </dependency>
        <!-- IO: nombre y extensión seguros de los archivos subidos (FilenameUtils) -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>${commons-io.version}</version>
        </dependency>

        <!-- Collections: utilidades null-safe para listas y mapas (CollectionUtils, MapUtils) en los reportes -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-collections4</artifactId>
            <version>${commons-collections4.version}</version>
        </dependency>

        <!-- Google Guava: caché del límite de intentos de login (CacheBuilder), validaciones (Preconditions),
             colecciones inmutables (ImmutableList, ImmutableMap) y agrupaciones (Multimap) -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${guava.version}</version>
        </dependency>

        <!-- Apache POI: generación de los reportes en Excel (.xlsx) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- Logback: viene incluido en los starters de Spring Boot (spring-boot-starter-logging);
             su configuración está en src/main/resources/logback-spring.xml -->

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Documentación HTML del código: ./mvnw javadoc:javadoc  ->  docs/apidocs/index.html -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <show>private</show>
                    <doclint>all,-missing</doclint>
                    <encoding>UTF-8</encoding>
                    <docencoding>UTF-8</docencoding>
                    <charset>UTF-8</charset>
                    <notimestamp>true</notimestamp>
                    <doctitle>TécnicoYa API ${project.version}</doctitle>
                    <windowtitle>TécnicoYa API</windowtitle>
                    <outputDirectory>${project.basedir}/docs</outputDirectory>
                    <!-- Sin esto, en Windows javadoc lee sus opciones en Cp1252 y rompe los acentos del título -->
                    <additionalJOptions>
                        <additionalJOption>-J-Dfile.encoding=UTF-8</additionalJOption>
                    </additionalJOptions>
                </configuration>
            </plugin>
            <!-- OWASP Dependency-Check: busca vulnerabilidades conocidas (CVE) en las librerías del proyecto.
                 No corre en cada build; ejecútelo a mano con  ./mvnw dependency-check:check
                 (la primera vez descarga la base de datos NVD y demora varios minutos).
                 El reporte queda en target/dependency-check-report.html -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency-check.version}</version>
                <configuration>
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                    <!-- Falla si alguna librería tiene una vulnerabilidad de severidad alta (CVSS >= 7) -->
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <!-- Opcional: con una clave gratuita de https://nvd.nist.gov/developers/request-an-api-key
                         en la variable de entorno NVD_API_KEY la descarga es mucho más rápida -->
                    <nvdApiKeyEnvironmentVariable>NVD_API_KEY</nvdApiKeyEnvironmentVariable>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
