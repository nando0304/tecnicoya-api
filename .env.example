# Copie este archivo como .env (ignorado por git) y complete sus credenciales de MySQL.
# Formato .properties: si la contraseña contiene una barra invertida \, escríbala como \\
DB_USER=root
DB_PASSWORD=
# DB_URL=jdbc:mysql://localhost:3306/tecnicoya_db?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
# SERVER_PORT=8080
# ARCHIVOS_DIR=uploads
# Clave para firmar los tokens JWT (mínimo 32 caracteres) y horas de validez del token.
# Si no la define, se usa la clave de desarrollo de application.properties.
# JWT_SECRET=
# JWT_HORAS_VALIDEZ=8
# Carpeta de los logs de Logback (por defecto, logs/ en la carpeta desde la que se inicia la API).
# LOGS_DIR=logs
# Protección contra fuerza bruta: intentos fallidos permitidos y minutos de bloqueo.
# LOGIN_MAX_INTENTOS=5
# LOGIN_MINUTOS_BLOQUEO=15
# Orígenes del front-end permitidos por CORS (separados por comas).
# CORS_ORIGENES=http://localhost:5173
# Monitoreo (docs/monitoreo.md): token de solo lectura con el que Prometheus lee /actuator/prometheus.
# Debe ser el mismo que el de monitoreo/prometheus/token.txt. Vacío = solo el administrador ve las métricas.
# MONITOREO_TOKEN=
# Milisegundos a partir de los cuales una consulta SQL se registra como lenta en el log.
# SQL_LENTA_MS=500
# Entorno que aparece en los logs JSON (desarrollo, pruebas, produccion).
# ENTORNO=desarrollo
