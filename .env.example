# Copie este archivo como .env (ignorado por git) y complete sus credenciales de MySQL.
# Formato .properties: si la contraseña contiene una barra invertida \, escríbala como \\
DB_USER=root
DB_PASSWORD=
# DB_URL=jdbc:mysql://localhost:3306/tecnicoya_db?useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
# SERVER_PORT=8080
# ARCHIVOS_DIR=uploads
# Clave para firmar los tokens JWT (mínimo 32 caracteres) y horas de validez del token.
# Si no la define, se usa la clave de desarrollo de application.properties.
# JWT_SECRET=
# JWT_HORAS_VALIDEZ=8
